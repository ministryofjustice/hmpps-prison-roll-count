{% extends "../partials/layout.njk" %}
{% from "../macros/establishmentRollStatCard.njk" import establishmentRollStatCard %}
{% from "../macros/alertFlags.njk" import alertFlags %}
{% from "../macros/categoryFlag.njk" import categoryFlag %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% set todayStats = establishmentRollCounts.todayStats %}

{% set pageTitle = "Out today" %}
{% set mainClasses = "govuk-body govuk-main-wrapper--auto-spacing" %}

{% set breadCrumbs = [
    {
        text: 'Digital Prison Services',
        href:  dpsUrl
    },
    {
        text: 'Establishment roll',
        href:  '/'
    }
] %}

{% block content %}
  <div class="govuk-width-container govuk-!-margin-top-4">
    <div class="govuk-!-margin-bottom-6">
      <h1 class="govuk-heading-l govuk-!-margin-bottom-0">{{ pageTitle }}</h1>
    </div>

    <div class="establishment-roll-cards-container establishment-roll-cards-container__stretch">
      {{
      establishmentRollStatCard(
        heading = "Temporary absence",
        value = todayStats.temporaryAbsence,
        qaTag = "temporary-absence-card"
      )
      }}

      {{
      establishmentRollStatCard(
        heading = "At court",
        value = todayStats.atCourt,
        qaTag = "at-court-card"
      )
      }}

      {{
      establishmentRollStatCard(
        heading = "Released",
        value = todayStats.released,
        qaTag = "released-card"
      )
      }}

      {{
      establishmentRollStatCard(
        heading = "Transferred out",
        value = todayStats.transferredOut,
        qaTag = "transferred-out-card"
      )
      }}
    </div>

  <div class="app-search-panel app-checkboxes--inline">
    <form method="get" action="/out-today" novalidate data-qa="property-search">
      <div class="app-search-panel__row app-search-panel__row--inline">
        {{ govukCheckboxes({
          name: "departureType",
          classes: "govuk-checkboxes--small",
          fieldset: {
            legend: {
              text: "Filter by departure type:",
              isPageHeading: true,
              classes: "govuk-fieldset__legend govuk-fieldset__legend--s"
            }
          },
          items: [
            {
              value: "temporaryAbsence",
              html: "Temporary absence (" ~ todayStats.temporaryAbsence ~ ")",
              checked: selectedFilters and 'temporaryAbsence' in selectedFilters
            },
            {
              value: "atCourt",
              html: "At court (" ~ todayStats.atCourt ~ ")",
              checked: selectedFilters and 'atCourt' in selectedFilters
            },
            {
              value: "released",
              html: "Released (" ~ todayStats.released ~ ")",
              checked: selectedFilters and 'released' in selectedFilters
            },
            {
              value: "transferredOut",
              html: "Transferred out (" ~ todayStats.transferredOut ~ ")",
              checked: selectedFilters and 'transferredOut' in selectedFilters
            }
          ]
        }) }}
      </div>
      <div class="app-search-panel__row">
        {{ govukButton({ text: "Apply", classes: "app-search-panel__button" }) }}
        <a class="govuk-link app-search-panel__clear" href="{{ clearFiltersHref or '/out-today?sort=' ~ sort }}" data-qa="clear-search">Clear</a>
      </div>

      {% if appliedFilters | length %}
        <div class="app-search-panel__selected" data-qa="selected-filters">
          <div class="app-search-panel__selected-header">
            <h3 class="govuk-heading-s govuk-!-margin-bottom-1">Selected filters</h3>
            <a class="govuk-link" href="{{ clearFiltersHref or '/out-today?sort=' ~ sort }}" data-qa="clear-all-filters">Clear filters</a>
          </div>
          <ul class="moj-filter-tags">
            {% for filter in appliedFilters %}
              <li>
                <a class="moj-filter__tag" href="{{ filter.href }}" data-qa="selected-filter">
                  <span class="govuk-visually-hidden">Remove this filter:</span> {{ filter.text }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    </form>
  </div>

  <div class="govuk-grid-row govuk-!-margin-bottom-9">
        <div class="govuk-grid-column-full results-table results-table__results">
            {% set sortParam = sort or 'timeOut&direction=descending' %}
            {% set returnPathWithSort = '/out-today?sort=' ~ sortParam %}
            {% set selectedFilterQuery = '' %}
            {% if selectedFilters %}
              {% for filter in selectedFilters %}
                {% set selectedFilterQuery = selectedFilterQuery ~ '&departureType=' ~ filter %}
              {% endfor %}
            {% endif %}
            {% set sortHrefTemplate = '?sort={sortKey}&direction={sortDirection}' ~ selectedFilterQuery %}
            {% set returnPathWithSort = '/out-today?sort=' ~ sortParam ~ selectedFilterQuery %}

            {% set rows = [] %}
            {% set blankRows = [
              [
                {
                  html: 'No people to display',
                  colspan: 8
                }
              ]
            ] %}
            {% for prisoner in prisoners %}
                {% set prisonerName = prisoner.firstName | formatName("", prisoner.lastName, { style: 'lastCommaFirst' }) %}

              {# Set departure type based on the latest movement type for this out-today row #}
              {% set departureTypeCode = prisoner.departureTypeCode or prisoner.lastMovementTypeCode %}
              {% if departureTypeCode === "TAP" %}
                {% set departureType = "Temporary absence" %}
              {% elseif departureTypeCode === "CRT" %}
                {% set departureType = "At court" %}
              {% elseif departureTypeCode === "REL" %}
                {% set departureType = "Release" %}
              {% elseif departureTypeCode === "TRN" %}
                {% set departureType = "Transfer" %}
              {% else %}
                {% set departureType = "" %}
              {% endif %}

              {% set rows = (rows.push([
                {
                  html: '<img src="/prisonerImage/' ~ (prisoner.prisonerNumber or 'placeholder') ~ '" alt="Image of ' ~ prisonerName ~ '" class="results-table__results__image" />'
                },
                {
                  html: '<a href="' ~ prisonerProfileBackLinkUrl('Back to Out today', returnPathWithSort, prisoner.prisonerNumber) ~ '" class="govuk-link">' ~ prisonerName ~ '</a>',
                  sortValue: prisoner.lastName,
                  attributes: {
                    "data-sort-value": prisoner.lastName.toLowerCase() if prisoner.displayName else ''
                  }
                },
                {
                  text: prisoner.prisonerNumber
                },
                {
                  html: departureType ~ (" - " ~ prisoner.reasonDescription if prisoner.reasonDescription else ''),
                  sortValue: departureType ~ (" - " ~ prisoner.reasonDescription if prisoner.reasonDescription else '')
                },
                {
                  html: prisoner.timeOut | formatTime,
                  sortValue: prisoner.timeOut
                },
                {
                  text: prisoner.goingTo or prisoner.toAddress or ''
                },
                {
                  text: prisoner.status,
                  sortValue: prisoner.status
                },
                {
                  html: alertFlags(prisoner.alertFlags) ~ categoryFlag('', prisoner.category) | safe
                }
              ]), rows) %}
            {% endfor %}

            {{ govukTable({
              caption: 'Out today (column headers with buttons are sortable)',
              captionClasses: 'govuk-visually-hidden',
              firstCellIsHeader: false,
              classes: 'govuk-table out-today-roll__table table-vertical-align-middle sortable-table govuk-!-font-size-16',
              head: [
                {
                  text: ''
                },
                {
                  text: "Name",
                  key: 'lastName',
                  classes: 'govuk-!-font-size-16'
                },
                {
                  text: "Prison number",
                  classes: 'govuk-!-font-size-16'
                },
                {
                  text: "Reason for absence",
                  key: 'reasonForAbsence',
                  classes: 'govuk-!-font-size-16'
                },
                {
                  text: "Time out",
                  key: 'timeOut',
                  classes: 'govuk-!-font-size-16'
                },
                {
                  text: 'To location',
                  classes: 'govuk-!-font-size-16'
                },
                {
                  text: 'Current status',
                  key: 'currentStatus',
                  classes: 'govuk-!-font-size-16'
                },
                {
                  text: 'Relevant alerts',
                  classes: 'govuk-!-font-size-16'
                }
              ] | convertToSortableColumns(sortParam, sortHrefTemplate),

              rows: rows if prisoners.length > 0 else blankRows
            }) }}
        </div>
    </div>
</div>
{% endblock %}
